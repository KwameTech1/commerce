# Optional — the store runs with zero environment variables.
# Set these to override the built-in defaults.
COMPANY_NAME="RareCart"
SITE_NAME="RareCart"
# Your Eversend payment tag URL (create one at https://eversend.me).
# The default is a demo placeholder that does not lead to a real payment page.
EVERSEND_PAYMENT_TAG_URL="https://eversend.me/your-tag"
